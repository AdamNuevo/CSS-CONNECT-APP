{
  "expo": {
    "name": "CCS Hub",
    "slug": "ccs-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E2A78"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.edu.qcu.ccs.hub"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E2A78"
      },
      "package": "ph.edu.qcu.ccs.hub"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "scheme": "ccs-hub",
    "extra": {
      "apiUrl": "http://localhost:3000/api/v1"
    }
  }
}
