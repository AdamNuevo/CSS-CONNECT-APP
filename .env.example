# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ccs_hub
POSTGRES_USER=ccs_hub_user
POSTGRES_PASSWORD=changeme_in_prod

# API
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ccs_hub_user:changeme_in_prod@localhost:5432/ccs_hub

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_hex
JWT_REFRESH_SECRET=replace_with_64_byte_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@ccs.qcu.edu.ph

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=20

# Mobile — set this to your dev machine's LAN IP when running Expo Go on a real device
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.42:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
